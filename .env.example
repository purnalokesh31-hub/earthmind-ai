# ──────────────────────────────────────────────────────────────
# EarthMind PIOS — Unified Environment Configuration Template
# Copy this file to `.env` in the project root and configure secrets
# ──────────────────────────────────────────────────────────────

# ── General Environment ─────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Next.js Web Command Center Configuration ────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_NAME="EarthMind PIOS"
NEXT_PUBLIC_VERSION="1.0.0"

# ── Database Connection (SQLite for local dev, PostgreSQL for container)
# Local SQLite default:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL + PostGIS:
# DATABASE_URL="postgresql://earthmind:earthmind_secure_pass_2026@localhost:5432/earthmind_db?schema=public"
DATABASE_POOL_SIZE=10

# ── Python Intelligence Engine (apps/api) ───────────────────────
AI_ENGINE_URL=http://localhost:8000
MOCK_AI=true
GEMINI_API_KEY=
AI_INFERENCE_TIMEOUT_MS=15000
AI_MIN_CONFIDENCE_THRESHOLD=0.45

# ── JWT Authentication Secrets ──────────────────────────────────
# Generated keys must be at least 32 characters in production
JWT_SECRET=earthmind-pios-dev-secret-key-change-me-in-production-32chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=earthmind-pios-dev-refresh-secret-key-change-me-in-prod
JWT_REFRESH_EXPIRES_IN=7d

# ── In-Memory Cache & Rate Limiting (Redis) ─────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Media Evidence Storage Driver ───────────────────────────────
# Supported drivers: local | s3 | gcs
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./public/uploads
S3_BUCKET_NAME=earthmind-assets
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
