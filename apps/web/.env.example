# ──────────────────────────────────────────────────────────────
# EarthMind PIOS — Centralized Environment Variables Template
# Copy this file to .env and configure secret keys for environment
# ──────────────────────────────────────────────────────────────

# ── Application Environment ───────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database Configuration (PostgreSQL + PostGIS) ─────────────
DATABASE_URL=postgresql://earthmind:earthmind_secure_pass_2026@localhost:5432/earthmind_db?schema=public
DATABASE_POOL_SIZE=10

# ── Authentication & JWT Secrets ──────────────────────────────
# In production, replace with 64-character cryptographically random strings
JWT_SECRET=earthmind-pios-dev-secret-key-change-me-in-production-32chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=earthmind-pios-dev-refresh-secret-key-change-me-in-prod
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis Cache & Rate Limiting ───────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── File Storage Provider ──────────────────────────────────────
# Drivers: local | s3 | gcs
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./public/uploads
S3_BUCKET_NAME=earthmind-assets
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── AI Engine Integration ──────────────────────────────────────
AI_ENGINE_URL=http://localhost:8000
AI_INFERENCE_TIMEOUT_MS=15000
AI_MIN_CONFIDENCE_THRESHOLD=0.45
